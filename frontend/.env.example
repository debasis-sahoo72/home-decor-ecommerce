# Server-only; never prefix secrets with NEXT_PUBLIC_.
BACKEND_URL=http://127.0.0.1:8000
SITE_URL=http://127.0.0.1:3000
# Enable only on the real HTTPS production origin before build; rebuild/restart after changes.
# Keep false for local/staging. Set SITE_URL to the same canonical origin at build and runtime.
SITE_INDEXABLE=false
