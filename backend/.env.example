APP_ENV=development
DATABASE_URL=postgresql+psycopg://decor:local-development-only@127.0.0.1:5432/decor
AUTH_SECRET=development-only-replace-before-production-32-chars
ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
SESSION_HOURS=168
IDLE_MINUTES=1440
ADMIN_SESSION_HOURS=8
ADMIN_IDLE_MINUTES=30
# Integration tests require a separate database with a name ending in _test.
# TEST_DATABASE_URL=postgresql+psycopg://decor:local-development-only@127.0.0.1:5432/decor_test
# Server-only Razorpay keys. Leave blank to keep payment disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Backend only; never use NEXT_PUBLIC_ for these credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Transactional notifications: keep disabled until providers are configured.
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Choose a supported Graph API version from your Meta dashboard (e.g. vXX.0).
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Approved utility templates, each with one BODY parameter: order/account reference.
WHATSAPP_TEMPLATES={}
